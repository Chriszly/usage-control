# Copy to .env and fill in to change the defaults. Never commit .env.

# Port on the host where the website is reachable (default 8080).
PORT=

# Published image to run: main (latest commit on main) or a version such as 1.2.3 (default main).
IMAGE_TAG=

# --- Deploy to a Raspberry Pi (read by scripts/deploy.sh on your PC) ----------
# Host name or IP of the Pi, e.g. pi5.local, or a Host from ~/.ssh/config.
PI_HOST=
# SSH user on the Pi. Empty: the user from ~/.ssh/config or your local user.
PI_USER=
# Folder on the Pi for compose.yaml and .env, relative to the user's home (default usage-control).
PI_DIR=
