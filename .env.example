# Copy to .env and fill in to change the defaults. Never commit .env.

# Port on the host where the website is reachable, over IPv4 (default 9393).
PORT=

# Published image to run: latest (newest release), a release such as 0.1.0 to stay on it,
# or main to follow every change on the main branch (default latest).
IMAGE_TAG=


# Comma-separated disks to show, such as /,/mnt/usb (default /). Mount every path
# except / read-only in compose.yaml first.
DISK_PATHS=

# Days of usage history to keep, from 1 to 3650 (default 30). Older values are
# deleted automatically. Takes effect when the container is restarted.
RETENTION_DAYS=

# How many disks, temperature sensors, network cards and GPUs each the history
# keeps per device, from 1 to 10000 (default 64); the dashboard shows them all.
HISTORY_MAX_ENTRIES=

# How the page names this device (default "Host Hub").
DEVICE_NAME=

# Hub mode: other devices on the local network whose usage this one collects
# and shows, as comma-separated name=address:port entries, such as
# Living room Pi=192.168.1.20:9393,Office PC=192.168.1.30:9393 (default none).
HUB_DEVICES=

# true serves only the usage data for a hub on another device, without the
# website and history, like the Windows installer does by default (default false).
DATA_ONLY=

# With DATA_ONLY, hours of usage this device keeps for a hub that cannot reach
# it, from 1 to 168; the hub fetches them once it can, and they are deleted
# then (default 24).
BUFFER_HOURS=

# true deletes the password for adding and removing devices on the page, if it
# is forgotten; the next device added chooses a new one. Unset it again after
# one restart (default false).
RESET_PASSWORD=

# false stops the daily question to GitHub whether a newer release exists,
# which the page then names (default true). Nothing is ever installed by it.
UPDATE_CHECK=

# The page answers only when opened by this machine's IP address, by localhost,
# by its hostname or by a .local name. Other names the page should be reachable
# by, such as one from the router's DNS, go here, comma-separated, such as
# pi.fritz.box,usage.home.lan (default none).
ALLOWED_HOSTS=

# Add-ons to run next to usage-control, comma-separated: power reads the power
# Intel and AMD CPUs draw, pressure how often tasks wait for the CPU, memory or
# disks, kernel what the kernel is busy with, wifi the quality and signal of
# the Wi-Fi link, memory memory details such as dirty and slab memory and page
# faults, ports the ports the machine listens on, containers the CPU and
# memory of each container, processes the processes using the most CPU and
# memory (default none). cub runs the lightweight ones, pressure, kernel, wifi
# and memory: the Cub edition. The Grizzly edition is cub with the others you
# want, such as cub,power,processes.
COMPOSE_PROFILES=

# Docker's data folder on this machine, from which the containers add-on reads
# the containers' names; set it if Docker keeps its data elsewhere, such as
# /home/pi/.local/share/docker for rootless Docker (with compose only; the
# archive's service cannot read /home). docker info shows it as Docker Root
# Dir (default /var/lib/docker).
DOCKER_DIR=
