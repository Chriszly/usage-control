# Copy to .env (git-ignored) and fill in. scripts/deploy.sh reads it and
# copies it to the Pi, where Docker Compose reads it next to compose.yaml.

# --- Deploy (read by scripts/deploy.sh) ---------------------------------------
# Host name or IP of the Pi, e.g. pi5.local, or a Host from ~/.ssh/config.
PI_HOST=
# SSH user on the Pi. Empty: the user from ~/.ssh/config or your local user.
PI_USER=
# Folder on the Pi for compose.yaml and .env, relative to the user's home.
# Default: usage-control
PI_DIR=

# --- Container (read by Docker Compose on the Pi) -----------------------------
# Image to run; must be built for arm64 (the Pi) and pushed to a registry.
IMAGE=ghcr.io/chriszly/usage-control:latest
# Port the website is reachable on, on the local network. Default: 8080
PORT=
# Days of usage data to keep; older data is deleted. Empty: the app's default.
RETENTION_DAYS=
