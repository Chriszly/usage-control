# The processes add-on of usage-control: reads the processes that use the most
# CPU and memory and writes them to /run/usage-control-addons, which
# usage-control shows. install.sh puts it in /etc/systemd/system when the
# add-on is picked.
[Unit]
Description=Usage Control processes add-on: lists the ten processes using the most CPU and memory; runs as root without capabilities
Documentation=https://github.com/Chriszly/usage-control
PartOf=usage-control.service
After=usage-control.service

[Service]
ExecStart=/usr/local/bin/usage-control-processes
Environment=ADDONS_DIR=/run/usage-control-addons
# The add-on folder usage-control reads; others may read it, only root writes.
RuntimeDirectory=usage-control-addons
RuntimeDirectoryMode=0755
# Shared with the other add-ons, so it stays when one of them stops.
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5

# Runs as root only to write the add-on folder all add-ons share, but without
# any capability: what it reads, /proc/stat and /proc/<pid>/stat, every user
# may read. It writes nothing but its folder, needs no network and starts no
# program.
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=
# Every process stays visible: no hidepid (ProtectProc) and all of /proc,
# which has the machine's CPU time in /proc/stat (ProcSubset).
ProtectProc=default
ProcSubset=all
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=usage-control.service
