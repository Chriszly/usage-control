# The ports add-on of usage-control: reads which TCP and UDP ports the machine
# listens on and writes them to /run/usage-control-addons, which
# usage-control shows. install.sh puts it in /etc/systemd/system when the
# add-on is picked.
[Unit]
Description=Usage Control ports add-on: lists the TCP and UDP ports the machine listens on, with their addresses; runs as root without capabilities
Documentation=https://github.com/Chriszly/usage-control
PartOf=usage-control.service
After=usage-control.service

[Service]
ExecStart=/usr/local/bin/usage-control-ports
Environment=ADDONS_DIR=/run/usage-control-addons
# The add-on folder usage-control reads; others may read it, only root writes.
RuntimeDirectory=usage-control-addons
RuntimeDirectoryMode=0755
# Shared with the other add-ons, so it stays when one of them stops.
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5

# Runs as root only to write the add-on folder it shares with the other
# add-ons, which root owns, and without any capability. It reads the socket
# tables of /proc/1/net, which any user may read. It stays in the host's
# network, without PrivateNetwork=yes, only so it reads the range of ports
# the host hands out from /proc/sys/net/ipv4/ip_local_port_range, which each
# network has of its own; it can still open no socket (RestrictAddressFamilies
# below) and send no packet (IPAddressDeny). It reads no process names:
# finding them would mean reading every process's /proc/<pid>/fd, which root
# without capabilities may not do for other users' processes.
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Only pseudo devices such as /dev/null: no disks, input or other hardware.
PrivateDevices=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# Without capabilities the clock cannot be set anyway; this also blocks the
# calls that set it, as in the other add-ons' units.
SystemCallFilter=~@clock
ProtectHostname=yes
# No socket of any kind: as root it could otherwise connect to the Unix
# sockets of services such as Docker or systemd and have them act for it.
RestrictAddressFamilies=none
# The call that opens a socket is denied as well, so this does not rest on
# how systemd reads "none": before 249 (as on Raspberry Pi OS bullseye) it
# warns that it does not know the word, though it still allows no family.
SystemCallFilter=~socket
# A denied call fails instead of ending the program.
SystemCallErrorNumber=EPERM
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=usage-control.service
