# Settings for usage-control; install.sh copies this to /etc/usage-control.env
# once and never overwrites it. Restart after a change:
#   sudo systemctl restart usage-control

# Address to listen on (default :9393, every network card).
LISTEN_ADDR=

# Comma-separated disks to show, such as /,/mnt/usb (default /).
DISK_PATHS=

# Days of usage history to keep, from 1 to 3650 (default 30).
RETENTION_DAYS=

# How many disks, sensors, network cards and GPUs each the history keeps per
# device, from 1 to 10000 (default 64).
HISTORY_MAX_ENTRIES=

# How the page names this device (default "Host Hub").
DEVICE_NAME=

# Hub mode: other devices to collect from, as name=address:port entries, such as
# Office PC=192.168.1.30:9393 (default none). Devices can also be added on the page.
HUB_DEVICES=

# Routers to read, shown as devices of their own, as name=protocol:address
# entries: Router=upnp:192.168.1.1 reads the internet traffic of most routers
# (ASUS, Technicolor, FRITZ!Box, provider boxes) without a login, with UPnP
# switched on in the router; Router=asus:admin@192.168.1.1 reads an ASUS
# router's CPU, memory, ports, Wi-Fi, clients and temperatures with its login.
# install.sh asks for the router and stores its password encrypted with
# systemd-creds; nothing read from the router leaves this machine (default none).
HUB_ROUTERS=

# true serves only the usage data for a hub, without website and history.
DATA_ONLY=

# With DATA_ONLY, hours of usage kept for a hub that cannot reach this device,
# from 1 to 168; deleted once the hub has them (default 24).
BUFFER_HOURS=

# true deletes the password for changing devices, if it is forgotten (default false).
RESET_PASSWORD=

# false stops the daily check for a newer release (default true).
UPDATE_CHECK=

# Other names the page may be opened by, besides the IP address, localhost, the
# hostname and .local names; comma-separated, such as pi.fritz.box (default none).
ALLOWED_HOSTS=

# For the containers add-on: Docker's data folder, from which it reads the
# containers' names, if Docker keeps its data elsewhere; docker info shows it as
# Docker Root Dir. Folders below /home cannot be read (default /var/lib/docker).
# The inodes add-on leaves out the containers' layers mounted below it.
DOCKER_DIR=
